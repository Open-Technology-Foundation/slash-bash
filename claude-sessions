#!/usr/bin/bash
# claude-sessions - list Claude Code sessions for the current working
# directory.
#
# Output: TSV (mtime<TAB>uuid<TAB>title), newest first. UUIDs are accepted
# by `claude --resume <uuid>`.
#
# Reads `~/.claude/projects/<encoded-cwd>/*.jsonl`, where <encoded-cwd> is
# the cwd with `/` replaced by `-` - matches Claude Code's own scheme.
# Title resolution: last `custom-title` record wins; falls back to the
# first user message truncated to 80 chars; final fallback is `<untitled>`.
#
# Used directly by the user, and by slash-bash's `/sessions` handler
# (which is a thin exec wrapper around this script).

set -euo pipefail
shopt -s inherit_errexit

declare -r VERSION=1.0.0
#shellcheck disable=SC2155
declare -r SCRIPT_PATH=$(realpath -- "${BASH_SOURCE[0]}")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

_msg()  { >&2 printf '%s: %s %s\n' "$SCRIPT_NAME" "$1" "${*:2}"; }
error() { _msg '✗' "$@"; }
die()   { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION [-V|--version] [-h|--help]

usage: $SCRIPT_NAME [-V|--version] [-h|--help]

  List Claude Code sessions for the current working directory as TSV:
    <mtime>\\t<uuid>\\t<title>
  newest first. UUIDs can be passed to \`claude --resume <uuid>\`.

  Reads ~/.claude/projects/<encoded-cwd>/*.jsonl.

  Exit codes:
    0   sessions listed (or none — but the directory exists)
    2   unexpected argument
    3   no session directory for the current cwd
    18  jq not found in PATH
    22  invalid option
HELP
}

main() {
  # shellcheck disable=SC2317  # all current arms terminate; shift kept for BCS0801 conformance
  while (($#)); do case $1 in
    -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; return 0 ;;
    -h|--help)    show_help; return 0 ;;
    -*)           die 22 "invalid option: ${1@Q}" ;;
    *)            die 2  "unexpected argument: ${1@Q}" ;;
  esac; shift; done

  local -- root=${SB_CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}
  local -- dir=$root/${PWD//\//-}
  [[ -d $dir ]] || die 3 "no sessions for $PWD"
  command -v jq >/dev/null || die 18 'jq not in PATH'

  local -- f uuid title mtime
  for f in "$dir"/*.jsonl; do
    [[ -f $f ]] || continue
    uuid=${f##*/}; uuid=${uuid%.jsonl}
    # Last custom-title record wins (titles get rewritten over a session).
    title=$(jq -r 'select(.type=="custom-title") | .customTitle' "$f" 2>/dev/null | tail -n1)
    # Fallback: first user message, truncated to 80 chars.
    if [[ -z $title ]]; then
      title=$(jq -r 'select(.type=="user") | .message.content | tostring' "$f" 2>/dev/null \
              | head -n1 | cut -c1-80)
      title=${title:-<untitled>}
    fi
    mtime=$(date -r "$f" '+%Y-%m-%d %H:%M:%S')
    printf '%s\t%s\t%s\n' "$mtime" "$uuid" "$title"
  done | sort -r
}

main "$@"

#fin
